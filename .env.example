# Example only. Set DATABASE_URL in the process environment; .env is not auto-loaded.
# Percent-encode special characters in URL usernames/passwords. Never commit secrets.
DATABASE_URL=postgresql+psycopg://careflow_app:REPLACE_ME@127.0.0.1:5432/careflow_ai
# Integration tests CREATE and DROP only fresh, randomly named disposable databases.
# Needs CREATEDB, CREATEROLE (temporary permission-test role), and pgvector privileges.
TEST_DATABASE_URL=postgresql+psycopg://postgres:REPLACE_ME@127.0.0.1:5432/postgres

# Exact HTTPS browser origin; omit trailing slash/path.
AUTH_ORIGIN=https://localhost:8000

# Chat is disabled by default. Key possession does not authorize paid calls.
# Enable only for an owner-approved live run; mocked tests need neither setting.
CHAT_ENABLED=false
ANTHROPIC_API_KEY=REPLACE_ME
CHAT_MODEL=claude-sonnet-5-5
CHAT_PROVIDER_CALLS=5
CHAT_TOOL_CALLS=4
CHAT_OUTPUT_TOKENS=1024
CHAT_CONTEXT_BYTES=48000
CHAT_RESPONSE_BYTES=16000
CHAT_TIMEOUT_SECONDS=20
CHAT_RATE_PER_MINUTE=10
